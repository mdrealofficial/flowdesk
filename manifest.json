{
  "manifest_version": 3,
  "name": "FlowDesk — Task CRM",
  "version": "1.0.0",
  "description": "A lightweight task CRM: capture tasks, move them through your pipeline, and keep your daily streak alive.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowDesk — Task CRM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
